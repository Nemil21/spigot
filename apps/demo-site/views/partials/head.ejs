<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %></title>
<style>
  :root {
    --paper:#fbf8f3; --surface:#fff; --sunk:#f4efe7; --line:#e7e0d4; --line-strong:#d6ccbb;
    --ink:#1b1f33; --body:#3c4155; --muted:#666a7c;
    --blue:#2c3d8f; --blue-deep:#1f2c6b; --blue-tint:#e8ebf7;
    --ok:#2e6a3e; --ok-tint:#e3efe2; --gone:#5f6273; --gone-tint:#ecebe7;
    --serif:"Iowan Old Style","Palatino Linotype",Palatino,"Book Antiqua",Georgia,serif;
    --sans:ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
    --r:10px; --shadow:0 1px 2px rgb(27 31 51 / .05),0 6px 20px -8px rgb(27 31 51 / .12);
  }
  *,*::before,*::after { box-sizing:border-box; }
  html { -webkit-text-size-adjust:100%; }
  body { margin:0; font:16px/1.6 var(--sans); color:var(--body); background:var(--paper); -webkit-font-smoothing:antialiased; display:flex; flex-direction:column; min-height:100vh; }
  ::selection { background:var(--blue); color:#fff; }
  h1,h2,h3 { color:var(--ink); line-height:1.15; text-wrap:balance; }
  h1 { font:600 clamp(2rem,1.4rem + 2.6vw,3.25rem)/1.08 var(--serif); letter-spacing:-.02em; margin:0 0 .75rem; }
  h2 { font:600 1.5rem/1.2 var(--serif); letter-spacing:-.01em; margin:2.75rem 0 1rem; }
  h3 { font-size:1.05rem; font-weight:600; margin:0; }
  p { margin:0 0 1rem; }
  a { color:var(--blue); text-underline-offset:.18em; text-decoration-thickness:1px; }
  a:hover { color:var(--blue-deep); }
  :focus-visible { outline:2px solid var(--blue); outline-offset:3px; border-radius:4px; }
  .muted { color:var(--muted); }
  .num { font-variant-numeric:tabular-nums; }

  header.site { position:sticky; top:0; z-index:10; display:flex; flex-wrap:wrap; gap:.5rem 2rem; align-items:center; justify-content:space-between; padding:.85rem max(1.25rem,calc((100vw - 1160px)/2 + 1.25rem)); background:rgb(251 248 243 / .92); border-bottom:1px solid var(--line); backdrop-filter:saturate(1.4) blur(8px); }
  header.site .brand { display:inline-flex; align-items:center; gap:.6rem; font:600 1.25rem/1 var(--serif); color:var(--ink); text-decoration:none; letter-spacing:-.01em; }
  header.site .brand b { color:var(--blue); font-weight:inherit; }
  header.site .brand svg { width:22px; height:28px; flex:none; }
  header.site nav { display:flex; gap:.25rem; }
  header.site nav a { padding:.45rem .75rem; border-radius:999px; color:var(--body); text-decoration:none; font-size:.95rem; font-weight:500; }
  header.site nav a:hover { background:var(--sunk); color:var(--ink); }
  header.site nav a[aria-current=page] { background:var(--blue-tint); color:var(--blue-deep); }
  main { flex:1; width:100%; max-width:1160px; margin:0 auto; padding:2.5rem 1.25rem 4rem; }

  footer.site { border-top:1px solid var(--line); background:var(--sunk); color:var(--muted); font-size:.9rem; padding:2.5rem max(1.25rem,calc((100vw - 1160px)/2 + 1.25rem)); display:grid; gap:.35rem; }
  footer.site .foot-brand { font:600 1.05rem/1 var(--serif); color:var(--ink); margin-bottom:.5rem; }
  footer.site p { margin:0; }
  footer.site .site-notice { color:var(--body); font-weight:500; }

  .grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(min(100%,260px),1fr)); gap:1.5rem 1.25rem; padding:0; margin:0; list-style:none; }
  .card { background:var(--surface); border:1px solid var(--line); border-radius:var(--r); padding:1.25rem; }
  .listing-card { position:relative; padding:0; overflow:hidden; display:flex; flex-direction:column; transition:box-shadow .2s cubic-bezier(.2,.7,.2,1),transform .2s cubic-bezier(.2,.7,.2,1); }
  .listing-card:hover { box-shadow:var(--shadow); transform:translateY(-2px); }
  .listing-card .art { display:block; width:100%; height:auto; aspect-ratio:16/9; border-bottom:1px solid var(--line); }
  .listing-card .card-body { padding:1rem 1.1rem 1.15rem; display:grid; gap:.2rem; }
  .listing-card h3 { font-size:1rem; line-height:1.35; text-wrap:pretty; }
  .listing-card h3 a { color:var(--ink); text-decoration:none; }
  .listing-card h3 a::after { content:""; position:absolute; inset:0; }
  .listing-card h3 a:hover { text-decoration:underline; }
  .listing-card .price { font:600 1.3rem/1.3 var(--sans); color:var(--ink); margin:.15rem 0 .1rem; }
  .listing-card .price .per { font-size:.85rem; font-weight:400; color:var(--muted); }
  .listing-card .meta { color:var(--muted); font-size:.9rem; }
  .listing-card .status-badge { position:absolute; top:.75rem; left:.75rem; }
  .listing-card:has(.status-leased) .art { filter:saturate(.25); opacity:.8; }

  .art { background:var(--sky); }
  .photo { aspect-ratio:3/1; border-radius:var(--r); overflow:hidden; border:1px solid var(--line); margin-bottom:2rem; }
  @media (max-width:560px) { .photo { aspect-ratio:2/1; } }
  .photo svg { display:block; width:100%; height:100%; background:var(--sky); }

  .status-badge,.avail-pill { display:inline-flex; align-items:center; gap:.4rem; padding:.2rem .65rem; border-radius:999px; font-size:.78rem; font-weight:600; letter-spacing:.01em; color:var(--ok); background:var(--ok-tint); box-shadow:inset 0 0 0 1px rgb(46 106 62 / .18); }
  .status-badge::before,.avail-pill::before { content:""; width:6px; height:6px; border-radius:50%; background:currentColor; }
  .status-badge.status-leased,.avail-pill.avail-leased { color:var(--gone); background:var(--gone-tint); box-shadow:inset 0 0 0 1px rgb(95 98 115 / .18); }

  dl.facts,dl.specs { display:grid; grid-template-columns:max-content 1fr; gap:0; margin:1.5rem 0; border-top:1px solid var(--line); }
  dl.facts dt,dl.specs dt,dl.facts dd,dl.specs dd { padding:.7rem 0; border-bottom:1px solid var(--line); }
  dl.facts dt,dl.specs dt { color:var(--muted); padding-right:2rem; font-size:.95rem; }
  dl.facts dd,dl.specs dd { margin:0; color:var(--ink); font-weight:500; font-variant-numeric:tabular-nums; }

  h1 + form.search { margin-top:1.75rem; }
  form.search { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)) auto; gap:.75rem; align-items:end; background:var(--surface); border:1px solid var(--line); border-radius:14px; padding:1rem; box-shadow:var(--shadow); }
  form.search label { display:grid; gap:.35rem; font-size:.8rem; font-weight:600; color:var(--muted); letter-spacing:.01em; }
  form.search input,form.search select { font:inherit; font-size:1rem; font-weight:400; color:var(--ink); width:100%; height:2.75rem; padding:0 .8rem; border:1px solid var(--line-strong); border-radius:8px; background:var(--surface); }
  form.search input:hover,form.search select:hover { border-color:var(--muted); }
  form.search button { font:inherit; font-weight:600; height:2.75rem; padding:0 1.6rem; border:0; border-radius:8px; color:#fff; background:var(--blue); cursor:pointer; }
  form.search button:hover { background:var(--blue-deep); }
  @media (max-width:760px) { form.search { grid-template-columns:1fr 1fr; } form.search label:nth-of-type(3) { grid-column:1/-1; } form.search button { grid-column:1/-1; } }

  .layout-2 { display:grid; grid-template-columns:minmax(0,1fr) 340px; gap:3rem; align-items:start; }
  .layout-2 aside { position:sticky; top:5.5rem; display:grid; gap:1rem; }
  @media (max-width:860px) { .layout-2 { grid-template-columns:1fr; gap:2rem; } .layout-2 aside { position:static; } }
  .price { font:600 2rem/1.2 var(--sans); color:var(--ink); margin:.25rem 0 .5rem; font-variant-numeric:tabular-nums; }
  .price .muted { font-size:1rem; font-weight:400; }
  .lede { font-size:1.1rem; color:var(--muted); }
  .aside-label { font:600 .8rem/1 var(--sans); color:var(--muted); letter-spacing:.04em; text-transform:uppercase; margin:0 0 .75rem; }
  .agent-card a.agent-name,.contact-box a.contact-name { display:block; font:600 1.15rem/1.3 var(--serif); color:var(--ink); text-decoration:none; }
  .agent-card a.agent-name:hover,.contact-box a.contact-name:hover { text-decoration:underline; }
  .agent-card .agent-brokerage,.contact-box .contact-firm { font-size:.9rem; margin-bottom:1rem; }
  .agent-card a.agent-phone,.contact-box a.contact-tel { display:flex; justify-content:center; padding:.7rem; border-radius:8px; background:var(--blue); color:#fff; text-decoration:none; font-weight:600; font-variant-numeric:tabular-nums; }
  .agent-card a.agent-phone:hover,.contact-box a.contact-tel:hover { background:var(--blue-deep); }
  .open-house-box a { font-weight:600; text-decoration:none; }
  .hero { padding:2rem 0 1rem; max-width:920px; }
  .hero h1 { font-size:clamp(2.25rem,1.5rem + 3.2vw,3.75rem); max-width:16ch; }
  .hero .lede { margin-bottom:1.75rem; }
  .hoods { display:flex; flex-wrap:wrap; gap:.5rem; align-items:center; margin-top:1.25rem; font-size:.9rem; }
  .hoods a { padding:.3rem .8rem; border:1px solid var(--line-strong); border-radius:999px; color:var(--body); text-decoration:none; background:var(--surface); }
  @media (max-width:560px) { .hoods { flex-wrap:nowrap; overflow-x:auto; margin-inline:-1.25rem; padding:0 1.25rem .25rem; scrollbar-width:none; } .hoods a,.hoods span { flex:none; } }
  .hoods a:hover { border-color:var(--blue); color:var(--blue); }
  .section-head { display:flex; align-items:baseline; justify-content:space-between; gap:1rem; margin:3.5rem 0 1.25rem; }
  .section-head h2 { margin:0; }
  .section-head a { font-weight:500; white-space:nowrap; }
  .agent-head { display:flex; gap:1.5rem; align-items:center; padding-bottom:2rem; border-bottom:1px solid var(--line); }
  .agent-head h1 { margin:0; }
  .agent-head .agent-brokerage { color:var(--muted); font-size:1.05rem; margin:.35rem 0 .9rem; }
  .avatar { flex:none; display:grid; place-items:center; width:96px; height:96px; border-radius:50%; background:var(--blue-tint); color:var(--blue-deep); font:600 2rem/1 var(--serif); box-shadow:inset 0 0 0 1px rgb(44 61 143 / .15); }
  .agent-contact { display:flex; flex-wrap:wrap; gap:.5rem; margin:0; }
  .agent-contact a { padding:.45rem .9rem; border:1px solid var(--line-strong); border-radius:8px; background:var(--surface); text-decoration:none; font-weight:500; font-size:.95rem; font-variant-numeric:tabular-nums; }
  .agent-contact a.agent-phone { background:var(--blue); border-color:var(--blue); color:#fff; }
  .agent-contact a.agent-phone:hover { background:var(--blue-deep); }
  .agent-body h2 { margin-top:2rem; }
  .agent-body dl.facts { margin-top:2rem; }
  @media (max-width:560px) { .agent-head { flex-direction:column; align-items:flex-start; } .avatar { width:72px; height:72px; font-size:1.5rem; } }
  .oh-art { width:100%; height:auto; border-radius:var(--r); border:1px solid var(--line); }
  .oh-notes { padding:1rem 1.25rem; background:var(--surface); border:1px solid var(--line); border-radius:var(--r); }
  .result-count { margin:1.5rem 0 1rem; color:var(--muted); font-weight:500; font-variant-numeric:tabular-nums; }
  .empty { padding:3rem 1.5rem; text-align:center; background:var(--surface); border:1px dashed var(--line-strong); border-radius:var(--r); }
  .empty p { color:var(--ink); }
  .pagination { display:flex; align-items:center; justify-content:center; gap:1rem; margin-top:2.5rem; color:var(--muted); font-variant-numeric:tabular-nums; }
  .pagination a { padding:.5rem 1rem; border:1px solid var(--line-strong); border-radius:8px; background:var(--surface); text-decoration:none; font-weight:500; }
  .pagination a:hover { border-color:var(--blue); }
  .posts { list-style:none; padding:0; margin:2rem 0 0; border-top:1px solid var(--line); }
  .posts li { padding:1.1rem 0; border-bottom:1px solid var(--line); display:flex; flex-wrap:wrap; justify-content:space-between; gap:.25rem 1rem; }
  .posts a { font:600 1.15rem/1.35 var(--serif); color:var(--ink); text-decoration:none; }
  .posts a:hover { color:var(--blue); }
  .empty-page { padding:4rem 0; }
  .crumbs { font-size:.9rem; color:var(--muted); margin-bottom:1rem; }
  .crumbs a { color:var(--muted); }
  .prose { max-width:68ch; }
  .prose p { font-size:1.05rem; }

  @media (prefers-reduced-motion:reduce) { *,*::before,*::after { transition:none !important; animation:none !important; } .listing-card:hover { transform:none; } }
</style>
</head>
<body>
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    <g id="h-ground"><rect width="320" height="180" fill="var(--sky)"/><rect y="148" width="320" height="32" fill="var(--ground)"/></g>
    <symbol id="h-bungalow" viewBox="0 0 320 180">
      <use href="#h-ground"/>
      <rect x="42" y="96" width="5" height="54" fill="#5a4a3c"/><circle cx="44" cy="92" r="26" fill="var(--tree)"/><circle cx="62" cy="104" r="18" fill="var(--tree)"/>
      <rect x="96" y="88" width="150" height="62" fill="var(--wall)"/>
      <polygon points="84,90 171,42 258,90" fill="var(--roof)"/>
      <rect x="110" y="104" width="30" height="24" fill="var(--glass)"/><rect x="202" y="104" width="30" height="24" fill="var(--glass)"/>
      <path d="M125 104v24M110 116h30M217 104v24M202 116h30" stroke="var(--wall)" stroke-width="2"/>
      <rect x="159" y="110" width="24" height="40" fill="var(--door)"/>
      <rect x="150" y="146" width="42" height="4" fill="var(--roof)" opacity=".35"/>
    </symbol>
    <symbol id="h-apartment" viewBox="0 0 320 180">
      <use href="#h-ground"/>
      <rect x="104" y="40" width="124" height="110" fill="var(--wall)"/>
      <rect x="98" y="34" width="136" height="8" fill="var(--roof)"/>
      <g fill="var(--glass)">
        <rect x="118" y="54" width="22" height="20"/><rect x="155" y="54" width="22" height="20"/><rect x="192" y="54" width="22" height="20"/>
        <rect x="118" y="86" width="22" height="20"/><rect x="155" y="86" width="22" height="20"/><rect x="192" y="86" width="22" height="20"/>
        <rect x="118" y="118" width="22" height="20"/><rect x="192" y="118" width="22" height="20"/>
      </g>
      <rect x="155" y="116" width="22" height="34" fill="var(--door)"/>
      <rect x="150" y="112" width="32" height="4" fill="var(--roof)"/>
      <rect x="262" y="104" width="5" height="46" fill="#5a4a3c"/><circle cx="264" cy="98" r="22" fill="var(--tree)"/><circle cx="249" cy="112" r="14" fill="var(--tree)"/>
    </symbol>
    <symbol id="h-house" viewBox="0 0 320 180">
      <use href="#h-ground"/>
      <rect x="66" y="74" width="118" height="76" fill="var(--wall)"/>
      <polygon points="56,77 125,32 194,77" fill="var(--roof)"/>
      <rect x="184" y="98" width="78" height="52" fill="var(--wall)"/>
      <polygon points="178,100 223,74 268,100" fill="var(--roof)"/>
      <rect x="196" y="114" width="54" height="36" fill="var(--roof)" opacity=".25"/>
      <path d="M196 123h54M196 132h54M196 141h54" stroke="var(--wall)" stroke-width="1.5" opacity=".7"/>
      <rect x="82" y="88" width="26" height="22" fill="var(--glass)"/><rect x="142" y="88" width="26" height="22" fill="var(--glass)"/>
      <rect x="82" y="120" width="26" height="22" fill="var(--glass)"/>
      <rect x="114" y="62" width="22" height="14" fill="var(--glass)"/>
      <rect x="140" y="112" width="24" height="38" fill="var(--door)"/>
      <rect x="30" y="112" width="4" height="38" fill="#5a4a3c"/><circle cx="32" cy="106" r="18" fill="var(--tree)"/>
    </symbol>
  </defs>
</svg>
<header class="site">
  <a class="brand" href="/" aria-label="Bluebonnet Rentals home">
    <svg viewBox="0 0 22 28" aria-hidden="true"><path d="M11 27V12" stroke="#4b6b45" stroke-width="1.6" stroke-linecap="round"/><path d="M11 21c-3 0-5-2-6-4 3 0 5 1 6 4z" fill="#4b6b45"/><g fill="#2c3d8f"><ellipse cx="11" cy="3.5" rx="2.2" ry="2.6"/><ellipse cx="8.2" cy="7.6" rx="2.5" ry="2.2"/><ellipse cx="13.8" cy="7.6" rx="2.5" ry="2.2"/><ellipse cx="7.4" cy="11.6" rx="2.7" ry="2.2"/><ellipse cx="14.6" cy="11.6" rx="2.7" ry="2.2"/></g><ellipse cx="11" cy="3.5" rx="1" ry="1.3" fill="#fff"/></svg>
    <span>Bluebonnet <b>Rentals</b></span>
  </a>
  <nav aria-label="Main">
    <a href="/search"<%- typeof path !== 'undefined' && path === '/search' ? ' aria-current="page"' : '' %>>Search</a>
    <a href="/blog"<%- typeof path !== 'undefined' && path.startsWith('/blog') ? ' aria-current="page"' : '' %>>Renter notes</a>
    <a href="/about"<%- typeof path !== 'undefined' && path === '/about' ? ' aria-current="page"' : '' %>>About</a>
  </nav>
</header>
<main>
