<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %></title>
<style>
  :root { --ink:#1f2933; --muted:#5f6b7a; --line:#e3e6ea; --accent:#3b5bdb; --bg:#fafaf7; --ok:#2b8a3e; --gone:#868e96; }
  * { box-sizing: border-box; }
  body { margin:0; font:16px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; color:var(--ink); background:var(--bg); }
  a { color:var(--accent); }
  header.site { display:flex; gap:1.5rem; align-items:center; padding:.9rem 1.5rem; background:#fff; border-bottom:1px solid var(--line); }
  header.site .brand { font-weight:700; font-size:1.15rem; color:var(--ink); text-decoration:none; }
  header.site .brand span { color:#4c6ef5; }
  header.site nav { display:flex; gap:1rem; }
  main { max-width:1080px; margin:0 auto; padding:1.5rem; }
  footer.site { border-top:1px solid var(--line); padding:1.25rem 1.5rem; color:var(--muted); font-size:.9rem; text-align:center; background:#fff; }
  .grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(240px, 1fr)); gap:1rem; padding:0; list-style:none; }
  .card { background:#fff; border:1px solid var(--line); border-radius:8px; padding:1rem; }
  .card h3 { margin:.25rem 0; font-size:1rem; }
  .muted { color:var(--muted); }
  .photo { aspect-ratio:16/7; border-radius:8px; background:linear-gradient(135deg,#dbe4ff,#e6fcf5); display:flex; align-items:center; justify-content:center; color:var(--muted); }
  .status-badge { display:inline-block; padding:.1rem .55rem; border-radius:999px; font-size:.8rem; font-weight:600; color:#fff; background:var(--ok); }
  .status-badge.status-leased { background:var(--gone); }
  .avail-pill { display:inline-block; padding:.1rem .55rem; border-radius:999px; font-size:.8rem; font-weight:600; color:#fff; background:var(--ok); }
  .avail-pill.avail-leased { background:var(--gone); }
  dl.facts { display:grid; grid-template-columns:max-content 1fr; gap:.35rem 1.25rem; }
  dl.facts dt { color:var(--muted); }
  dl.facts dd { margin:0; }
  dl.specs { display:grid; grid-template-columns:max-content 1fr; gap:.35rem 1.25rem; }
  dl.specs dt { color:var(--muted); }
  dl.specs dd { margin:0; }
  form.search { display:flex; flex-wrap:wrap; gap:.75rem; align-items:end; background:#fff; border:1px solid var(--line); border-radius:8px; padding:1rem; }
  form.search label { display:flex; flex-direction:column; font-size:.85rem; color:var(--muted); }
  form.search input, form.search select, form.search button { font:inherit; padding:.4rem .5rem; }
  .layout-2 { display:grid; grid-template-columns:2fr 1fr; gap:1.5rem; }
  @media (max-width: 760px) { .layout-2 { grid-template-columns:1fr; } }
  .price { font-size:1.5rem; font-weight:700; margin:.25rem 0; }
</style>
</head>
<body>
<header class="site">
  <a class="brand" href="/">Bluebonnet <span>Rentals</span></a>
  <nav><a href="/search">Search</a><a href="/blog">Renter notes</a><a href="/about">About</a></nav>
</header>
<main>
