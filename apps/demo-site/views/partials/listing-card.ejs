<% var a = art(l); %><li class="card listing-card">
  <svg class="art" viewBox="0 0 320 180" style="<%= a.style %>" aria-hidden="true" focusable="false"><use href="#h-<%= a.kind %>" width="320" height="180"<%- a.flip ? ' transform="translate(320 0) scale(-1 1)"' : '' %>/></svg>
  <span class="status-badge status-<%= l.status %>"><%= l.status === 'leased' ? 'Leased' : 'Available' %></span>
  <div class="card-body">
  <h3><a href="/listings/<%= l.slug %>"><%= l.title %></a></h3>
  <div class="price num"><%= money(l.price_usd) %><span class="per"> / month</span></div>
  <div class="muted meta num"><%= beds(l.bedrooms) %> · <%= baths(l.bathrooms) %> · <%= num(l.sqft) %> sq ft</div>
  <div class="muted meta"><%= l.neighbourhood %>, <%= l.city %></div>
  </div>
</li>
