<%# DEMO_LAYOUT=v2 (SP-052a, the drift demo): the "redesign". Same data and JSON-LD as listing.ejs,
    but every listing CSS class is renamed and available_from moves out of the facts list into
    the move-in line under the price. %>
<%- include('partials/head') %>
<script type="application/ld+json">
<%- jsonLd %>
</script>
<article class="rental">
  <% var a = art(listing); %><nav class="crumbs" aria-label="Breadcrumb"><a href="/search">Rentals</a> / <a href="/search?neighbourhood=<%= encodeURIComponent(listing.neighbourhood) %>"><%= listing.neighbourhood %></a></nav>
  <div class="photo" role="img" aria-label="Illustration of <%= listing.title %>"><svg viewBox="-80 24 480 160" preserveAspectRatio="xMidYMax slice" style="<%= a.style %>"><use href="#h-<%= a.kind %>" width="320" height="180"<%- a.flip ? ' transform="translate(320 0) scale(-1 1)"' : '' %>/><rect x="-80" y="148" width="480" height="40" fill="var(--ground)"/></svg></div>
  <div class="layout-2">
    <div>
      <span class="avail-pill avail-<%= listing.status %>"><%= listing.status === 'leased' ? 'Leased' : 'Available' %></span>
      <h1 class="rental-name"><%= listing.title %></h1>
      <p class="price"><span class="rental-rent"><%= money(listing.price_usd) %></span> <span class="muted">/ month</span></p>
      <p class="move-in">Move in from <time class="move-in-date" datetime="<%= listing.available_from %>"><%= date(listing.available_from) %></time></p>
      <p class="rental-location"><%= listing.street_address %>, <%= listing.city %>, <%= listing.state %> <%= listing.postal_code %></p>
      <dl class="specs">
        <dt>Rent</dt><dd data-spec="rent"><%= money(listing.price_usd) %></dd>
        <dt>Bedrooms</dt><dd data-spec="beds"><%= listing.bedrooms %></dd>
        <dt>Bathrooms</dt><dd data-spec="baths"><%= listing.bathrooms %></dd>
        <dt>Size</dt><dd data-spec="size"><%= num(listing.sqft) %> sq ft</dd>
        <dt>Neighbourhood</dt><dd data-spec="area"><%= listing.neighbourhood %></dd>
        <dt>Pets</dt><dd data-spec="pet-policy"><%= listing.pets_allowed %></dd>
        <dt>Availability</dt><dd data-spec="state"><%= listing.status === 'leased' ? 'Leased' : 'Available' %></dd>
      </dl>
      <h2>About this place</h2>
      <p class="rental-blurb"><%= listing.description %></p>
      <p class="muted updated">Last updated <time datetime="<%= listing.updated_at %>"><%= date(listing.updated_at) %></time></p>
    </div>
    <aside>
      <% if (agent) { %>
      <div class="card contact-box">
        <h2 class="aside-label">Contact</h2>
        <a class="contact-name" href="/agents/<%= agent.slug %>"><%= agent.name %></a>
        <div class="contact-firm muted"><%= agent.brokerage %></div>
        <a class="contact-tel" href="tel:<%= agent.phone.replace(/[^0-9]/g, '') %>"><%= agent.phone %></a>
      </div>
      <% } %>
      <% openHouses.forEach(function (oh) { %>
      <div class="card open-house-box">
        <h2 class="aside-label">Open house</h2>
        <a href="/open-houses/<%= oh.id %>"><time datetime="<%= oh.starts_at %>"><%= day(oh.starts_at) %>, <%= time(oh.starts_at) %></time></a>
      </div>
      <% }) %>
    </aside>
  </div>
</article>
<%- include('partials/foot') %>
