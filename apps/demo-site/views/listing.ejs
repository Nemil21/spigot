<%- include('partials/head') %>
<script type="application/ld+json">
<%- jsonLd %>
</script>
<article class="listing">
  <% var a = art(listing); %><nav class="crumbs" aria-label="Breadcrumb"><a href="/search">Rentals</a> / <a href="/search?neighbourhood=<%= encodeURIComponent(listing.neighbourhood) %>"><%= listing.neighbourhood %></a></nav>
  <div class="photo" role="img" aria-label="Illustration of <%= listing.title %>"><svg viewBox="-80 24 480 160" preserveAspectRatio="xMidYMax slice" style="<%= a.style %>"><use href="#h-<%= a.kind %>" width="320" height="180"<%- a.flip ? ' transform="translate(320 0) scale(-1 1)"' : '' %>/><rect x="-80" y="148" width="480" height="40" fill="var(--ground)"/></svg></div>
  <div class="layout-2">
    <div>
      <span class="status-badge status-<%= listing.status %>"><%= listing.status === 'leased' ? 'Leased' : 'Available' %></span>
      <h1 class="listing-title"><%= listing.title %></h1>
      <p class="price"><span class="listing-price"><%= money(listing.price_usd) %></span> <span class="muted">/ month</span></p>
      <p class="listing-address"><%= listing.street_address %>, <%= listing.city %>, <%= listing.state %> <%= listing.postal_code %></p>
      <dl class="facts">
        <dt>Rent</dt><dd data-k="price"><%= money(listing.price_usd) %></dd>
        <dt>Bedrooms</dt><dd data-k="bedrooms"><%= listing.bedrooms %></dd>
        <dt>Bathrooms</dt><dd data-k="bathrooms"><%= listing.bathrooms %></dd>
        <dt>Size</dt><dd data-k="sqft"><%= num(listing.sqft) %> sq ft</dd>
        <dt>Neighbourhood</dt><dd data-k="neighbourhood"><%= listing.neighbourhood %></dd>
        <dt>Available from</dt><dd data-k="available"><%= listing.available_from %></dd>
        <dt>Pets allowed</dt><dd data-k="pets"><%= listing.pets_allowed %></dd>
        <dt>Status</dt><dd data-k="status"><%= listing.status === 'leased' ? 'Leased' : 'Available' %></dd>
      </dl>
      <h2>About this place</h2>
      <p class="listing-description"><%= listing.description %></p>
      <p class="muted updated">Last updated <time datetime="<%= listing.updated_at %>"><%= date(listing.updated_at) %></time></p>
    </div>
    <aside>
      <% if (agent) { %>
      <div class="card agent-card">
        <h2 class="aside-label">Listing agent</h2>
        <a class="agent-name" href="/agents/<%= agent.slug %>"><%= agent.name %></a>
        <div class="agent-brokerage muted"><%= agent.brokerage %></div>
        <a class="agent-phone" href="tel:<%= agent.phone.replace(/[^0-9]/g, '') %>"><%= agent.phone %></a>
      </div>
      <% } %>
      <% openHouses.forEach(function (oh) { %>
      <div class="card open-house-box">
        <h2 class="aside-label">Open house</h2>
        <a href="/open-houses/<%= oh.id %>"><time datetime="<%= oh.starts_at %>"><%= day(oh.starts_at) %>, <%= time(oh.starts_at) %></time></a>
      </div>
      <% }) %>
    </aside>
  </div>
</article>
<%- include('partials/foot') %>
