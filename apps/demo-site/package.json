{
  "name": "@spigot/demo-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Bluebonnet Rentals: a fictional listings site Spigot crawls in the demo. Not a real business.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=2",
    "seed": "tsx src/scripts/seed.ts",
    "demo:mutate": "tsx src/scripts/mutate.ts"
  },
  "dependencies": {
    "@faker-js/faker": "10.6.0",
    "@spigot/gate": "^0.0.0",
    "ejs": "^3.1.10",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@spigot/shared": "^0.0.0",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.0",
    "@types/supertest": "^7.2.1",
    "cheerio": "^1.2.0",
    "supertest": "^7.1.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
