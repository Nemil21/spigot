# Bluebonnet Rentals demo site (apps/demo-site). Fictional; not a real business.
PORT=4100
# Scales listing / agent / open-house counts (0.05 in CI). Default 1 = 2,341 / 88 / 40.
DEMO_SEED_SCALE=
# Directory for the seed snapshot (bluebonnet.json) and, from SP-004b, the mutation log.
DEMO_DATA_DIR=
# Bearer token for /admin/{mutate,reset,state} (SP-004b). Unset → every /admin path is a 404.
DEMO_ADMIN_TOKEN=
# Served at /.well-known/spigot.txt for Spigot's site verification (404 when unset).
SPIGOT_VERIFY_TOKEN=
# spigot-gate (SP-006b). Spigot API origin, e.g. https://spigot.onrender.com (no path).
SPIGOT_API_BASE=
# Site gate key gk_… from connecting the site in Spigot (W03). Unset → gate off, site serves normally.
SPIGOT_GATE_KEY=
# 1 = demo mode: requests with X-Spigot-Sim: 1 (sim:bots) are counted as simulated.
SPIGOT_GATE_DEMO=
