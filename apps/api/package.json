{
  "name": "@spigot/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Spigot API: publisher REST, buyer /v1, /mcp, gate endpoints, webhooks; also the task functions Render Workflows runs.",
  "main": "./dist/main.js",
  "exports": {
    "./tasks": {
      "types": "./dist/tasks/index.d.ts",
      "default": "./dist/tasks/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed:demo": "tsx --conditions=source src/cli/seed-demo.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@fastify/autoload": "^6.5.1",
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@spigot/shared": "^0.0.0",
    "argon2": "^0.45.2",
    "cheerio": "^1.2.0",
    "fast-json-patch": "^3.1.1",
    "fastify": "^5.12.8",
    "jsonpath-plus": "^11.3.0",
    "p-queue": "^10.0.0",
    "pg": "^8.23.1",
    "re2-wasm": "^1.0.2",
    "undici": "^8.12.4",
    "uuid": "^14.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "fast-check": "^4.10.2",
    "supertest": "^7.3.2"
  }
}
