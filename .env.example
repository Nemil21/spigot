# Spigot environment. Copy to `.env` (git-ignored) and fill in. This file lists every key any
# part of Spigot reads, with no values: nobody else edits it (SP-001a). Never commit real values.
# apps/api/src/config.ts validates these at boot and names any missing or invalid key.

# --- Required at boot ------------------------------------------------------------------------
# Local: run `npm run dev:db` (scripts/dev-db.sh) and paste the URLs it prints, e.g.
#   postgres://spigot:spigot@127.0.0.1:54329/spigot_<worktree>
DATABASE_URL=
# 32+ random characters, e.g. `openssl rand -hex 32`.
SESSION_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# https://api-m.sandbox.paypal.com. A non-sandbox base is refused unless PAYPAL_ENV=live.
PAYPAL_API_BASE=
# Public URL of the API + web app, e.g. http://localhost:3000.
APP_BASE_URL=

# --- Required only when the feature is used ---------------------------------------------------
# Schema agent (Claude).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
AG_GRID_LICENSE_KEY=
# PayPal webhook signature verification.
PAYPAL_WEBHOOK_ID=
# Render Workflows (WORKFLOWS_MODE=workflows).
RENDER_API_KEY=
RENDER_WORKFLOWS_SERVICE_ID=
# Comma-separated admin logins.
ADMIN_EMAILS=
# The separate sandbox business account that receives the demo publisher's payouts.
DEMO_PUBLISHER_PAYOUT_EMAIL=

# --- Flags -------------------------------------------------------------------------------------
# sandbox (default) | stub (FakePayPal, no network)
PAYPAL_MODE=
# sandbox (default) | live
PAYPAL_ENV=
# true lets DEMO_MODE send PayPal-Mock-Response declines (forced false on a live base).
ALLOW_MOCK_DECLINE=
# inproc (default) | workflows
WORKFLOWS_MODE=
# live (default) | recorded (replays recorded proposals, no key; default under NODE_ENV=test)
SCHEMA_AGENT_MODE=
DEMO_MODE=
# on | off (default): wallet vault on top-ups.
PAYPAL_WALLET_VAULT=

# --- Demo site, gate and demo tooling --------------------------------------------------------
SPIGOT_GATE_DEMO=
SPIGOT_VERIFY_TOKEN=
SPIGOT_API_BASE=
SPIGOT_GATE_KEY=
SPIGOT_SITE_ID=
SPIGOT_CRAWL_KEY=
DEMO_ADMIN_TOKEN=
DEMO_SITE_URL=
# true lets the crawler reach loopback / private origins (local demo site, dev only).
ALLOW_LOCAL_ORIGINS=
DEMO_LAYOUT=
DEMO_SEED_SCALE=
# Milliseconds between two fetches to the same host (default 250).
CRAWL_MIN_GAP_MS=
# off (default) | browser: render JS-heavy templates through headless Chromium (needs `playwright`).
CRAWL_RENDER=

# --- Web app (Vite; exposed to the browser, so never a secret) ---------------------------------
VITE_FIXTURES=
VITE_AG_GRID_LICENSE_KEY=
VITE_PAYPAL_CLIENT_ID=

# --- Runtime -----------------------------------------------------------------------------------
# development (default) | test | production
NODE_ENV=
PORT=
HOST=
LOG_LEVEL=

# --- Tests ---------------------------------------------------------------------------------------
# Database the `*.db.test.ts` tests may wipe; `npm run dev:db` prints it (spigot_<worktree>_test).
TEST_DATABASE_URL=
