{
  "name": "spigot",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Spigot: publishers get paid when AI agents read their sites.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "db"
  ],
  "scripts": {
    "dev": "npm run dev -w @spigot/api",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start -w @spigot/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "openapi": "npm run build -w @spigot/shared && tsx apps/api/src/openapi/generate.ts",
    "test": "vitest run --project unit --project web --maxWorkers=2",
    "test:db": "npm test -w @spigot/db",
    "migrate": "npm run migrate -w @spigot/db",
    "security:secrets": "bash scripts/secret-scan.sh",
    "security:audit": "npm audit --audit-level=high",
    "dev:db": "bash scripts/dev-db.sh",
    "seed:demo": "npm run seed:demo -w @spigot/api --",
    "sim:bots": "tsx scripts/sim-bots.ts",
    "sim:buyers": "node scripts/not-yet.mjs sim:buyers SP-036",
    "demo:mutate": "npm run demo:mutate -w @spigot/demo-site --",
    "demo:reset": "node scripts/not-yet.mjs demo:reset SP-038",
    "demo:payout": "node scripts/not-yet.mjs demo:payout SP-038",
    "demo:decline": "node scripts/not-yet.mjs demo:decline SP-047b"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "prettier": "^3.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  }
}
